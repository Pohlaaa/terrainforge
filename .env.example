# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic (Claude API)
VITE_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Stripe
VITE_STRIPE_PK=pk_test_your_stripe_publishable_key
VITE_STRIPE_PRICE_STARTER=price_starter_id_here
VITE_STRIPE_PRICE_PRO=price_pro_id_here
VITE_STRIPE_PRICE_BUSINESS=price_business_id_here

# Mapbox (address autocomplete + map widgets)
VITE_MAPBOX_TOKEN=pk.your-mapbox-token-here

# Dev-only auto-sign-in (gated by import.meta.env.DEV — stripped from prod builds)
# Set these in .env.local to skip the login screen when running `npm run dev`.
# Used by AuthContext.tsx to auto-call signInWithPassword on app mount when no
# session exists. Never commit real credentials. Leave blank in .env.example.
VITE_DEV_AUTO_SIGNIN_EMAIL=
VITE_DEV_AUTO_SIGNIN_PASSWORD=

# Dev-only billing gate bypass (same DEV-gated pattern — stripped from prod builds).
# Set to "true" to skip the trial-expired / subscription gate while running
# `npm run dev`. Used by useBillingGate.ts. Leave blank or unset in prod.
VITE_DEV_BYPASS_BILLING=

# Client-response email notification (Sprint 7d)
# When set, the /share/:token viewer calls this Edge Function after a client
# approves or requests changes, so the contractor gets an email.
# Deploy supabase/functions/notify-client-response first, then set this URL.
# Blank/unset = no emails sent; the in-app banner on OverviewTab still works.
VITE_RESPONSE_NOTIFY_URL=
