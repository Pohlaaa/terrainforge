# Copy to .env.e2e and fill in. Never commit the filled file.
# Loaded by playwright via dotenv-cli (npm run e2e wraps it).

# ── Required ──────────────────────────────────────────────────────────
# Contractor account that signs in to the staging deploy.
E2E_EMAIL=woodsrider82@gmail.com
E2E_PASSWORD=

# Supabase anon key for direct RPC negative tests. Same key the
# frontend uses; safe to share but treat as semi-private.
E2E_SUPABASE_ANON_KEY=

# ── Optional overrides ───────────────────────────────────────────────
# Default points at https://terrainforge-staging.netlify.app
# E2E_BASE_URL=https://terrainforge-staging.netlify.app

# Default points at the staging Supabase project URL
# E2E_SUPABASE_URL=https://axasujjoywqadzuisvaj.supabase.co
